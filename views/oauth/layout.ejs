<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · ' : '' %>Sign in with Syncup</title>
<link rel="stylesheet" href="/oauth/assets/portal.css">
<script src="/oauth/assets/portal.js" defer></script>
</head>
<body class="oauth-body">
<div class="shell">
  <header class="topbar">
    <span class="brand">
      <span class="brand-mark" aria-hidden="true"></span>
      <span>Sign in with <b>Syncup</b></span>
    </span>
  </header>
  <main class="content content-narrow">
    <%- body %>
  </main>
  <footer class="oauth-foot muted small" aria-hidden="true">
    Private by design — apps only ever see a scoped, per-app identifier.
  </footer>
</div>
</body>
</html>
