# nginx config for the ops agent — add inside the existing api.crackman.in
# HTTPS server block. The agent binds 127.0.0.1 only; nginx terminates TLS
# and proxies /ops/ to it.

location /ops/ {
    proxy_pass http://127.0.0.1:5055;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;   # deploy step polls are long-ish
}

# Deploy:
#   pm2 start ecosystem.config.js --only ops-agent
#   # then reload nginx after adding the location block:
#   nginx -t && systemctl reload nginx
